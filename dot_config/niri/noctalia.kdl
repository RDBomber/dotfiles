layout {

    focus-ring {
        active-color   "#ffb1c6"
        inactive-color "#1c1013"
        urgent-color   "#ffb4ab"
    }

    border {
        active-color   "#ffb1c6"
        inactive-color "#1c1013"
        urgent-color   "#ffb4ab"
    }


    tab-indicator {
        active-color   "#ffb1c6"
        inactive-color "#f35892"
        urgent-color   "#ffb4ab"
    }

    insert-hint {
        color "#ffb1c680"
    }
}

recent-windows {
    highlight {
        active-color "#ffb1c6"
        urgent-color "#ffb4ab"
    }
}
