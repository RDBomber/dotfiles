// https://niri-wm.github.io/niri/Configuration:-Layout
layout {
    gaps 4

    center-focused-column "never"

    preset-column-widths {
        proportion 0.33333
        proportion 0.5
        proportion 0.66667
    }

    focus-ring {
        off 
        width 2
    }

    border {
        off
    }

    tab-indicator {
        width 8
        gap 4
        position "top"
    }
}

recent-windows {
    off
}




